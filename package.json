{
  "name": "merlins-cloak-v2",
  "displayName": "Merlin's Cloak v2",
  "description": "WXT + React rebuild of Merlin's Cloak, a client-side re-theme of the AsusWRT-Merlin router web UI.",
  "private": true,
  "license": "MIT",
  "homepage": "https://starlightdaemon.github.io/merlins_cloak_v2/",
  "version": "0.9.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fujin/ui": "github:StarlightDaemon/Fujin#v0.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "overrides": {
    "shell-quote": "1.9.0",
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "uuid": "11.1.1",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "wxt": "^0.21.2"
  }
}
